# Browser key for Maps JavaScript, Places, and Routes.
# Restrict it to http://localhost:3857/* and http://127.0.0.1:3857/*
GOOGLE_MAPS_API_KEY=

# Google Identity Services web client. JavaScript origin: http://localhost:3857
GOOGLE_CLIENT_ID=

# Local sign-in while the Google client is not ready. Leave unset on a shared host.
GATHER_DEV_AUTH=

# Optional. A file in ~/.local/share/gather is used when this is empty.
GATHER_SESSION_SECRET=

# Set only to use the Firestore emulator, for example 127.0.0.1:8080.
# Leave this empty on Cloud Run.
FIRESTORE_EMULATOR_HOST=

# Emulator project id, or the Gather Cloud project when GATHER_USE_FIRESTORE=live.
# Do not point this at Waymark.
GATHER_FIRESTORE_PROJECT=

# Set to live only for the Gather Cloud Run service. Local dev stays on the file store.
GATHER_USE_FIRESTORE=

# YouVersion Platform app key from https://platform.youversion.com
# Server only. It is not sent to the browser. NIV, ESV, and the other
# translations appear after those licenses are accepted for this key.
YVP_APP_KEY=

# Comma-separated emails that can see churches able to fill an auditorium together.
CHOSEN_SG_EMAILS=
